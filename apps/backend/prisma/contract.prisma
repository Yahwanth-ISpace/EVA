// use prisma-8

enum Role {
  @@type("mongo/string@1")
  ADMIN    = "ADMIN"
  OPERATOR = "OPERATOR"
}

enum AgentStatus {
  @@type("mongo/string@1")
  IN_PROGRESS = "IN_PROGRESS"
  READY       = "READY"
  SUSPENDED   = "SUSPENDED"
}

model User {
  id        ObjectId @id @map("_id")
  email     String   @unique
  password  String
  role      Role
  firstName String?
  lastName  String?
  dob       Date?
  createdAt temporal.createdAt()
  payee     Payee?   @relation("UserPayee")
  @@map("User")
}

model Payee {
  id        ObjectId @id @map("_id")
  user      User?    @relation("UserPayee", fields: [userId], references: [id])
  userId    ObjectId? @unique
  firstName String
  lastName  String
  dob       Date?
  ssn       String?
  payer     Payer?   @relation(fields: [payerId], references: [id])
  payerId   ObjectId?
  @@map("Payee")
}

model VerificationRequirement {
  id                 ObjectId       @id @map("_id")
  payeeId            String
  verificationFields Json
  createdAt          temporal.createdAt()
  updatedAt          temporal.updatedAt()
  verifications      Verification[]
  @@map("VerificationRequirement")
}

model Payer {
  id             ObjectId @id @map("_id")
  companyName    String
  phone          String
  phoneExt       String?
  groupName      String
  groupNumber    String
  businessKey    String
  planName       String
  pristinePlanId Int64Number
  Payee          Payee[]
  @@map("Payer")
}

model Provider {
  id           ObjectId      @id @map("_id")
  firstName    String
  lastName     String
  npi          String        @unique
  network      String
  specialty    String
  offices      Office[]
  appointments Appointment[]
  @@map("Provider")
}

model Office {
  id           ObjectId      @id @map("_id")
  name         String
  address1     String
  address2     String?
  city         String
  state        String
  zip          String
  code         String
  provider     Provider      @relation(fields: [providerId], references: [id])
  providerId   ObjectId
  appointments Appointment[]
  @@map("Office")
}

model Appointment {
  id         ObjectId  @id @map("_id")
  provider   Provider? @relation(fields: [providerId], references: [id])
  providerId ObjectId?
  office     Office?   @relation(fields: [officeId], references: [id])
  officeId   ObjectId?
  @@map("Appointment")
}

model Verification {
  id                        ObjectId                 @id @map("_id")
  payeeId                   String?
  appointmentId             String?
  verificationRequirement   VerificationRequirement? @relation(fields: [verificationRequirementId], references: [id])
  verificationRequirementId ObjectId?
  extractedData             Json?
  transcript                String
  createdAt                 temporal.createdAt()
  @@map("Verification")
}

model Agent {
  id                   ObjectId    @id @map("_id")
  name                 String      @unique
  twilioPhoneNumber    String
  twilioPhoneNumberExt String
  status               AgentStatus
  startTime            Date?
  endTime              Date?
  @@map("Agent")
}

model BotTracker {
  id        ObjectId @id @map("_id")
  payeeId   String
  callLog   Json?
  createdAt temporal.createdAt()
  @@map("BotTracker")
}
