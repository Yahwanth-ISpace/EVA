generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid()) @map("_id")
  email     String    @unique
  password  String
  role      Role
  firstName String?
  lastName  String?
  dob       DateTime?
  createdAt DateTime  @default(now())
  payee     Payee?    @relation("UserPayee")
}

model Payee {
  id        String    @id @default(uuid()) @map("_id")
  user      User?     @relation("UserPayee", fields: [userId], references: [id])
  userId    String?   @unique
  firstName String
  lastName  String
  dob       DateTime?
  ssn       String? //make manditory in production (US Citizens)
  payer     Payer?    @relation(fields: [payerId], references: [id])
  payerId   String?
}

/// Defines which fields to collect during a verification call and in what order.
/// Payee can have multiple verification requirements (e.g. different plans or call types).
model VerificationRequirement {
  id                 String         @id @default(uuid()) @map("_id")
  /// Legacy field name: stores external `PatientID` from Mongo `appointments` or a legacy Payee `_id`.
  payeeId            String
  /// Array of { field: string, required: boolean, order: number } — fields to ask for, in order.
  verificationFields Json // e.g. [{"field":"coverage","required":true,"order":1},{"field":"deductible","required":true,"order":2},{"field":"copay","required":true,"order":3},{"field":"validity","required":true,"order":4}]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  verifications      Verification[]
}

model Payer {
  id             String  @id @default(uuid()) @map("_id")
  companyName    String
  phone          String
  phoneExt       String?
  groupName      String
  groupNumber    String
  businessKey    String
  planName       String
  pristinePlanId Int
  Payee          Payee[]
}

model Provider {
  id           String        @id @default(uuid()) @map("_id")
  firstName    String
  lastName     String
  npi          String        @unique
  network      String
  specialty    String
  offices      Office[]
  appointments Appointment[]
}

model Office {
  id           String        @id @default(uuid()) @map("_id")
  name         String
  address1     String
  address2     String?
  city         String
  state        String
  zip          String
  code         String
  provider     Provider      @relation(fields: [providerId], references: [id])
  providerId   String
  appointments Appointment[]
}

