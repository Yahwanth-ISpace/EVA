generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid()) @map("_id")
  email     String    @unique
  password  String
  role      Role
  firstName String?
  lastName  String?
  dob       DateTime?
  createdAt DateTime  @default(now())
  payee     Payee?    @relation("UserPayee")
}

model Payee {
  id            String         @id @default(uuid()) @map("_id")
  user          User?          @relation("UserPayee", fields: [userId], references: [id])
  userId        String?        @unique
  firstName     String
  lastName      String
  dob           DateTime?
  ssn           String? //make manditory in production (US Citizens)
  appointments  Appointment[]
  payer         Payer?         @relation(fields: [payerId], references: [id])
  payerId       String?
  verifications Verification[]
}

model Payer {
  id             String  @id @default(uuid()) @map("_id")
  companyName    String
  phone          String
  phoneExt       String?
  groupName      String
  groupNumber    String
  businessKey    String
  planName       String
  pristinePlanId Int
  Payee          Payee[]
}

model Provider {
  id           String        @id @default(uuid()) @map("_id")
  firstName    String
  lastName     String
  npi          String        @unique
  network      String
  specialty    String
  appointments Appointment[]
  offices      Office[]
}

model Office {
  id           String        @id @default(uuid()) @map("_id")
  name         String
  address1     String
  address2     String?
  city         String
  state        String
  zip          String
  code         String
  provider     Provider      @relation(fields: [providerId], references: [id])
  providerId   String
  appointments Appointment[]
}

model Appointment {
  id         String   @id @default(uuid()) @map("_id")
  payee      Payee    @relation(fields: [payeeId], references: [id])
  payeeId    String
  provider   Provider @relation(fields: [providerId], references: [id])
  providerId String
  office     Office   @relation(fields: [officeId], references: [id])
  officeId   String
  date       DateTime
  notes      String?
}

model Verification {
  id         String   @id @default(uuid()) @map("_id")
  payee      Payee?   @relation(fields: [payeeId], references: [id])
  payeeId    String?
  coverage   String
  deductible String
  copay      String
  validity   String
  transcript String
  createdAt  DateTime @default(now())
}

enum Role {
  ADMIN
  PAYEE
}
