model Verification {
  id                        String                   @id @default(uuid()) @map("_id")
  /// Legacy name: external `PatientID` from Mongo `appointments` or legacy Payee `_id` (no Prisma relation).
  payeeId                   String?
  /// Sabrina `AppointmentID` or legacy Prisma appointment `_id` (no Prisma relation — source of truth is Mongo `appointments`).
  appointmentId             String?
  verificationRequirement   VerificationRequirement? @relation(fields: [verificationRequirementId], references: [id])
  verificationRequirementId String?
  /// Dynamic field values (key = field name from VerificationRequirement.verificationFields). Used when verificationRequirementId is set.
  extractedData             Json?
  transcript                String
  createdAt                 DateTime                 @default(now())
}

model Agent {
  id                   String      @id @default(uuid()) @map("_id")
  name                 String      @unique
  twilioPhoneNumber    String
  twilioPhoneNumberExt String
  status               AgentStatus
  startTime            DateTime?   @default(now())
  endTime              DateTime?   @default(now())
}

model BotTracker {
  id        String   @id @default(uuid()) @map("_id")
  payeeId   String
  callLog   Json?
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  PAYEE
}

enum AgentStatus {
  IN_PROGRESS
  READY
  SUSPENDED
}
