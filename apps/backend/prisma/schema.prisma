generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid()) @map("_id")
  email     String    @unique
  password  String
  role      Role
  firstName String?
  lastName  String?
  dob       DateTime?
  createdAt DateTime  @default(now())
  payee     Payee?    @relation("UserPayee")
}

model Payee {
  id                     String                   @id @default(uuid()) @map("_id")
  user                   User?                    @relation("UserPayee", fields: [userId], references: [id])
  userId                 String?                  @unique
  firstName              String
  lastName               String
  dob                    DateTime?
  ssn                    String? //make manditory in production (US Citizens)
  appointments           Appointment[]
  payer                  Payer?                   @relation(fields: [payerId], references: [id])
  payerId                String?
  verifications          Verification[]
  verificationRequirements VerificationRequirement[]
}

/// Defines which fields to collect during a verification call and in what order.
/// Payee can have multiple verification requirements (e.g. different plans or call types).
model VerificationRequirement {
  id                 String   @id @default(uuid()) @map("_id")
  payeeId            String
  payee              Payee     @relation(fields: [payeeId], references: [id], onDelete: Cascade)
  /// Array of { field: string, required: boolean, order: number, question?: string } — fields to ask for, in order. Optional "question" is the exact phrase to ask (e.g. "Can you provide me the coverage"); when missing, the system asks using the field name.
  verificationFields Json     // e.g. [{"field":"coverage","required":true,"order":1},{"question":"Can you provide me the coverage","field":"coverage","required":true,"order":1}]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  verifications      Verification[]
}

model Payer {
  id             String  @id @default(uuid()) @map("_id")
  companyName    String
  phone          String
  phoneExt       String?
  groupName      String
  groupNumber    String
  businessKey    String
  planName       String
  pristinePlanId Int
  Payee          Payee[]
}

model Provider {
  id           String        @id @default(uuid()) @map("_id")
  firstName    String
  lastName     String
  npi          String        @unique
  network      String
  specialty    String
  appointments Appointment[]
  offices      Office[]
}

model Office {
  id           String        @id @default(uuid()) @map("_id")
  name         String
  address1     String
  address2     String?
  city         String
  state        String
  zip          String
  code         String
  provider     Provider      @relation(fields: [providerId], references: [id])
  providerId   String
  appointments Appointment[]
}

model Appointment {
  id         String   @id @default(uuid()) @map("_id")
  payee      Payee    @relation(fields: [payeeId], references: [id])
  payeeId    String
  provider   Provider @relation(fields: [providerId], references: [id])
  providerId String
  office     Office   @relation(fields: [officeId], references: [id])
  officeId   String
  date       DateTime
  notes      String?
}

model Verification {
  id                      String                 @id @default(uuid()) @map("_id")
  payee                   Payee?                 @relation(fields: [payeeId], references: [id])
  payeeId                 String?
  verificationRequirement VerificationRequirement? @relation(fields: [verificationRequirementId], references: [id])
  verificationRequirementId String?
  /// Dynamic field values (key = field name from VerificationRequirement.verificationFields). Used when verificationRequirementId is set.
  extractedData          Json?
  transcript              String
  createdAt               DateTime @default(now())
}

enum Role {
  ADMIN
  PAYEE
}
