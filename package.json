{
  "name": "eva",
  "version": "1.0.0",
  "scripts": {
    "start:backend": "cd apps/backend && npm run start:dev",
    "start:client": "cd apps/client && npm start",
    "ai-server": "cd ./apps/ai-server && ./venv/Scripts/python.exe -m uvicorn main:app --host 0.0.0.0 --port 8000",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:client\" \"npm run ai-server\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "overrides": {
    "lodash": "4.18.1",
    "shell-quote": "1.12.0"
  }
}
